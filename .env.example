# GEMINI_API_KEY: Required for Gemini AI API calls on your backend server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PORT: Optional server configuration
PORT=3000

# VITE_API_BASE_URL: Backend URL when frontend is hosted separately on Netlify (e.g. https://your-backend.onrender.com)
# Leave empty if frontend and backend are served from the same domain
VITE_API_BASE_URL=""

# VITE_ADSENSE_CLIENT_ID: Optional Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=""

