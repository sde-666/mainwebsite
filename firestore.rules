rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read resources, notes, and tests for studying
    match /resources/{resourceId} {
      allow read, write: if true;
    }
    
    match /mcq_tests/{testId} {
      allow read, write: if true;
    }
    
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
    
    match /site_settings/{settingId} {
      allow read, write: if true;
    }

    match /test_results/{resultId} {
      allow read, create, update, delete: if true;
    }

    match /practical_tests/{testId} {
      allow read, write: if true;
    }

    match /practical_submissions/{submissionId} {
      allow read, create, update, delete: if true;
    }

    match /notes_courses/{courseId} {
      allow read, write: if true;
    }

    match /notes_chapters/{chapterId} {
      allow read, write: if true;
    }

    match /notes_topics/{topicId} {
      allow read, write: if true;
    }

    match /chapter_mcqs/{mcqId} {
      allow read, write: if true;
    }
    match /paid_courses/{courseId} {
      allow read, write: if true;
    }
    match /paid_course_chapters/{chapterId} {
      allow read, write: if true;
    }
    match /paid_course_lessons/{lessonId} {
      allow read, write: if true;
    }
    match /paid_course_enrollments/{enrollmentId} {
      allow read, write: if true;
    }
    match /app_settings/{settingId} {
      allow read, write: if true;
    }
  }
}

